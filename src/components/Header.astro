---
import Seal from './Seal.astro';
import { getLocaleFromUrl, useTranslations, localizePath, locales, htmlLang } from '../i18n/utils';

interface Props { path: string; }
const { path } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const links = [
  { href: '/homes', label: t('nav.homes') },
  { href: '/commercial', label: t('nav.commercial') },
  { href: '/rentals', label: t('nav.rentals') },
  { href: '/owners', label: t('nav.owners') },
  { href: '/neighborhoods', label: t('nav.neighborhoods') },
  { href: '/about', label: t('nav.about') },
  { href: '/contact', label: t('nav.contact') }
];
const short: Record<string, string> = { en: 'EN', zh: '中文' };
---
<header class="site-header">
  <div class="wrap inner">
    <a class="brand" href={localizePath('/', locale)}>
      <Seal size={38} />
      <span class="brand-text">
        <span class="brand-name">Ling Jordan</span>
        <span class="brand-sub">Golden Realty &middot; Frisco, TX</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a
          class="nav-link"
          href={localizePath(l.href, locale)}
          aria-current={path === l.href ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </nav>

    <div class="head-right">
      <nav class="lang" aria-label="Language">
        {locales.map((l, i) => (
          <>
            {i > 0 && <span class="lang-sep" aria-hidden="true">/</span>}
            <a
              href={localizePath(path, l)}
              hreflang={htmlLang[l]}
              lang={htmlLang[l]}
              aria-current={l === locale ? 'true' : undefined}
              class={l === locale ? 'lang-on' : ''}
            >{short[l]}</a>
          </>
        ))}
      </nav>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span class="menu-bars" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Main" hidden>
    <div class="wrap">
      {links.map((l) => (
        <a href={localizePath(l.href, locale)} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: rgba(245, 241, 232, .95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--mist);
  }
  .site-header .inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: .7rem;
  }

  .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; flex: 0 0 auto; }
  .brand-text { display: block; line-height: 1.15; }
  .brand-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 500;
    color: var(--jade-deep);
    white-space: nowrap;
    letter-spacing: -.01em;
  }
  .brand-sub {
    display: block;
    font-size: .6rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
    margin-top: .1rem;
  }

  .nav { display: flex; align-items: center; gap: 1.5rem; margin-left: auto; }
  .nav-link {
    font-size: .875rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    padding-block: .25rem;
    border-bottom: 1.5px solid transparent;
  }
  .nav-link:hover { color: var(--jade); }
  .nav-link[aria-current="page"] { color: var(--jade); border-bottom-color: var(--brass); }

  .head-right { display: flex; align-items: center; gap: .85rem; flex: 0 0 auto; margin-left: 0; }
  .lang { display: flex; align-items: center; gap: .4rem; font-size: .8rem; white-space: nowrap; }
  .lang a { text-decoration: none; color: var(--ink-soft); }
  .lang a:hover { color: var(--jade); }
  .lang .lang-on { color: var(--jade-deep); font-weight: 500; }
  .lang-sep { color: var(--mist); }

  .menu-btn {
    display: none;
    width: 40px; height: 40px;
    align-items: center; justify-content: center;
    background: none; border: 1px solid var(--mist); border-radius: 2px;
    cursor: pointer; padding: 0;
  }
  .menu-bars, .menu-bars::before, .menu-bars::after {
    display: block; width: 17px; height: 1.5px; background: var(--jade-deep); content: "";
  }
  .menu-bars { position: relative; }
  .menu-bars::before { position: absolute; top: -5px; }
  .menu-bars::after { position: absolute; top: 5px; }
  .menu-btn[aria-expanded="true"] .menu-bars { background: transparent; }
  .menu-btn[aria-expanded="true"] .menu-bars::before { top: 0; transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] .menu-bars::after { top: 0; transform: rotate(-45deg); }

  .mobile-nav { border-top: 1px solid var(--mist); background: var(--paper); }
  .mobile-nav .wrap { display: flex; flex-direction: column; padding-block: .5rem; }
  .mobile-nav a {
    padding: .8rem 0;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--mist);
    font-size: .95rem;
  }
  .mobile-nav a:last-child { border-bottom: 0; }
  .mobile-nav a[aria-current="page"] { color: var(--jade); font-weight: 500; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 1080px) {
    .nav { display: none; }
    .menu-btn { display: flex; }
    .head-right { margin-left: auto; }
  }
  @media (max-width: 420px) {
    .brand-sub { display: none; }
    .brand-name { font-size: 1.1rem; }
  }
</style>

<script>
  const btn = document.querySelector('.menu-btn');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    panel.hidden = open;
  });
</script>
