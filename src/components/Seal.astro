---
interface Props { size?: number; }
const { size = 44 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 100 100" role="img" aria-label="XNJ monogram" focusable="false">
  <rect x="2" y="2" width="96" height="96" rx="14" fill="#14584a" />
  <rect x="10" y="10" width="80" height="80" rx="8" fill="none" stroke="#b08d45" stroke-width="1" />
  <text x="50" y="62" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="30" font-weight="500" letter-spacing="1.5" fill="#f5f1e8">XNJ</text>
</svg>
