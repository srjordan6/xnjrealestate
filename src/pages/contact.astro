---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact Ling Jordan | Frisco, TX Real Estate"
  description="Call, text, or email Ling Jordan. Licensed Texas agent with Golden Realty serving Plano, Frisco, McKinney, Prosper, and Allen."
  path="/contact"
>
  <section class="wrap section narrow">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch.</h1>
    <p class="lede">
      Call or text is fastest. I answer my own phone, and a first conversation
      does not obligate you to anything.
    </p>
  </section>

  <section class="wrap" style="padding-bottom:clamp(3rem,8vw,5rem)">
    <div class="grid grid-2">
      <div>
        <h2 style="margin-top:0">Direct</h2>
        <table>
          <tbody>
            <tr><td>Cell</td><td><a href="tel:+19728157644">972-815-7644</a></td></tr>
            <tr><td>Office</td><td><a href="tel:+12148888036">214-888-8036</a></td></tr>
            <tr><td>Email</td><td><a href="mailto:ling@xnjrealestate.com">ling@xnjrealestate.com</a></td></tr>
          </tbody>
        </table>
        <h3>Office</h3>
        <p style="margin:0">
          Golden Realty<br />
          7700 Preston Rd Ste 501<br />
          Frisco, TX 75034
        </p>
      </div>

      <div>
        <h2 style="margin-top:0">Send a message</h2>
        <form id="lead" novalidate>
          <p style="margin:0 0 1rem">
            <label for="name" style="display:block;font-size:var(--step--1);margin-bottom:.3rem">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required
              style="width:100%;padding:.7rem;border:1px solid var(--mist);background:var(--paper);font:inherit" />
          </p>
          <p style="margin:0 0 1rem">
            <label for="phone" style="display:block;font-size:var(--step--1);margin-bottom:.3rem">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required
              style="width:100%;padding:.7rem;border:1px solid var(--mist);background:var(--paper);font:inherit" />
          </p>
          <p style="margin:0 0 1rem">
            <label for="topic" style="display:block;font-size:var(--step--1);margin-bottom:.3rem">What can I help with?</label>
            <select id="topic" name="topic"
              style="width:100%;padding:.7rem;border:1px solid var(--mist);background:var(--paper);font:inherit">
              <option>Buying a home</option>
              <option>Selling a home</option>
              <option>Commercial property</option>
              <option>Property management</option>
              <option>Something else</option>
            </select>
          </p>
          <p style="margin:0 0 1.25rem">
            <label for="message" style="display:block;font-size:var(--step--1);margin-bottom:.3rem">Details (optional)</label>
            <textarea id="message" name="message" rows="4"
              style="width:100%;padding:.7rem;border:1px solid var(--mist);background:var(--paper);font:inherit"></textarea>
          </p>
          <p id="err" role="alert" style="display:none;color:#a32d2d;font-size:var(--step--1);margin:0 0 1rem"></p>
          <button class="btn btn-primary" type="submit" style="cursor:pointer">Send</button>
        </form>
        <p class="notice" style="margin-top:1.5rem">
          TODO &mdash; this form is not wired up yet. Build the Cloudflare Worker
          endpoint and connect it before launch, or the field is decorative.
        </p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('lead');
    const err = document.getElementById('err');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('name');
      const phone = document.getElementById('phone');
      if (!name.value.trim() || !phone.value.trim()) {
        err.textContent = 'Enter your name and a phone number so Ling can reach you.';
        err.style.display = 'block';
        return;
      }
      err.style.display = 'none';
      err.textContent = '';
      alert('Form endpoint not connected yet. Please call or text 972-815-7644.');
    });
    ['name', 'phone'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => {
        err.style.display = 'none';
      });
    });
  </script>
</Base>
