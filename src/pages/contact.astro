---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact Ling Jordan | Frisco, TX"
  description="Call, text, or email Ling Jordan. Licensed Texas agent serving Plano, Frisco, McKinney, Prosper, and Allen."
  path="/contact"
>
  <header style="padding:1.25rem var(--gutter);border-bottom:1px solid var(--mist)">
    <a href="/" style="text-decoration:none;color:var(--jade)">&larr; Ling Jordan</a>
  </header>
  <section style="padding:clamp(2rem,6vw,4rem) var(--gutter);max-width:44rem">
    <h1 style="margin:0 0 1.5rem">Get in touch</h1>
    <p style="margin:0 0 2rem">Call or text is fastest. She answers her own phone.</p>

    <dl style="margin:0 0 2.5rem">
      <dt style="font-weight:500">Cell</dt>
      <dd style="margin:0 0 1rem"><a href="tel:+19728157644">972-815-7644</a></dd>
      <dt style="font-weight:500">Office</dt>
      <dd style="margin:0 0 1rem"><a href="tel:+12148888036">214-888-8036</a></dd>
      <dt style="font-weight:500">Email</dt>
      <dd style="margin:0 0 1rem"><a href="mailto:ling@xnjrealestate.com">ling@xnjrealestate.com</a></dd>
      <dt style="font-weight:500">Office address</dt>
      <dd style="margin:0">7700 Preston Rd Ste 501<br />Frisco, TX 75034</dd>
    </dl>

    <p style="font-size:var(--step--1)">
      TODO-COPY — replace this block with the lead form once the Worker
      endpoint is built. Three fields maximum: name, phone, and one context field.
    </p>
  </section>
</Base>
