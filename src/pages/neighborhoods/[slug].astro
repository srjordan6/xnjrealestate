---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('neighborhoods');
  return guides
    .filter((g) => g.data.locale === 'en')
    .map((g) => ({ params: { slug: g.data.slug }, props: { entry: g } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title} | Ling Jordan`} description={d.description} path={`/neighborhoods/${d.slug}`}>
  <section class="wrap section narrow">
    <p class="eyebrow">{d.county} County &middot; {d.schoolDistrict}</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.description}</p>
  </section>

  <section class="wrap narrow" style="padding-bottom:clamp(3rem,8vw,5rem)">
    <table>
      <tbody>
        <tr><td>School district</td><td>{d.schoolDistrict}</td></tr>
        <tr><td>Zip codes</td><td>{d.zips.join(', ')}</td></tr>
        {d.medianPrice && <tr><td>Median list price</td><td>${d.medianPrice.toLocaleString('en-US')}</td></tr>}
      </tbody>
    </table>
    <p class="notice">
      Median price is an estimate pending live NTREIS data. Verify before publishing.
    </p>

    <article class="prose">
      <Content />
    </article>

    <div class="btn-row" style="margin-top:2.5rem">
      <a class="btn btn-primary" href="/homes">Search homes in {d.city}</a>
      <a class="btn btn-secondary" href="/contact">Ask about {d.city}</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Place",
    "name": `${d.city}, Texas`,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": d.city,
      "addressRegion": "TX",
      "addressCountry": "US"
    }
  })} />
</Base>
