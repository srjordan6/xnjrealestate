---
import Base from '../layouts/Base.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('neighborhoods'))
  .filter((g) => g.data.locale === 'en')
  .sort((a, b) => a.data.city.localeCompare(b.data.city));
---
<Base
  title="Ling Jordan | Homes, Commercial, and Property Management in Collin County"
  description="Licensed Texas agent serving Plano, Frisco, McKinney, Prosper, and Allen. Residential sales, commercial real estate, and property management. Service in English and Mandarin."
  path="/"
>
  <header style="display:flex;justify-content:space-between;align-items:center;padding:1.25rem var(--gutter);border-bottom:1px solid var(--mist)">
    <a href="/" style="font-family:var(--font-display);font-size:var(--step-1);text-decoration:none;color:var(--jade)">Ling Jordan</a>
    <LanguageSwitcher path="/" />
  </header>

  <section style="padding:clamp(3rem,10vw,7rem) var(--gutter);max-width:60rem">
    <h1 style="margin:0 0 1.5rem">Homes, commercial, and property management across Collin County.</h1>
    <p style="max-width:var(--measure);font-size:var(--step-1);margin:0 0 2.5rem;color:var(--jade-deep)">
      Licensed Texas agent based in Frisco. Serving Plano, Frisco, McKinney, Prosper, and Allen.
      Service in English and Mandarin.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap">
      <a class="btn btn-primary" href="/homes">Buy or sell a home</a>
      <a class="btn btn-secondary" href="/owners">I own property</a>
    </div>
  </section>

  <section style="padding:0 var(--gutter) clamp(3rem,8vw,5rem)">
    <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
      <article style="border-top:2px solid var(--jade);padding-top:1.25rem">
        <h2 style="font-size:var(--step-1);margin:0 0 .5rem">Residential</h2>
        <p style="margin:0 0 1rem">Buying and selling homes, including new construction and builder contracts.</p>
        <a href="/homes">Search homes &rarr;</a>
      </article>
      <article style="border-top:2px solid var(--brass);padding-top:1.25rem">
        <h2 style="font-size:var(--step-1);margin:0 0 .5rem">Commercial</h2>
        <p style="margin:0 0 1rem">Texas Accredited Commercial Specialist. Retail, office, flex, industrial, and land.</p>
        <a href="/commercial">Commercial services &rarr;</a>
      </article>
      <article style="border-top:2px solid var(--jade-deep);padding-top:1.25rem">
        <h2 style="font-size:var(--step-1);margin:0 0 .5rem">Property management</h2>
        <p style="margin:0 0 1rem">50 doors under management. Published fees, licensed oversight, no call center.</p>
        <a href="/owners">Owner services &rarr;</a>
      </article>
    </div>
  </section>

  <section style="background:var(--paper);padding:clamp(2.5rem,6vw,4rem) var(--gutter);border-top:1px solid var(--mist);border-bottom:1px solid var(--mist)">
    <div style="display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));max-width:60rem">
      <div>
        <p style="font-family:var(--font-display);font-size:var(--step-2);margin:0;color:var(--jade)">50</p>
        <p style="margin:0;font-size:var(--step--1)">doors under management</p>
      </div>
      <div>
        <p style="font-family:var(--font-display);font-size:var(--step-2);margin:0;color:var(--jade)">TACS</p>
        <p style="margin:0;font-size:var(--step--1)">Texas Accredited Commercial Specialist</p>
      </div>
      <div>
        <p style="font-family:var(--font-display);font-size:var(--step-2);margin:0;color:var(--jade)">5</p>
        <p style="margin:0;font-size:var(--step--1)">Collin County cities served</p>
      </div>
    </div>
  </section>

  <section style="padding:clamp(3rem,8vw,5rem) var(--gutter)">
    <h2 style="margin:0 0 1.5rem">Neighborhood guides</h2>
    <div style="display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
      {guides.map((g) => (
        <a href={`/neighborhoods/${g.data.slug}`} style="text-decoration:none;color:inherit;border:1px solid var(--mist);padding:1.25rem;background:var(--paper)">
          <h3 style="margin:0 0 .35rem;font-size:var(--step-1);color:var(--jade)">{g.data.city}</h3>
          <p style="margin:0;font-size:var(--step--1)">{g.data.schoolDistrict}</p>
        </a>
      ))}
    </div>
  </section>

  <section style="background:var(--jade);color:var(--snow);padding:clamp(3rem,8vw,5rem) var(--gutter)">
    <h2 style="margin:0 0 1rem;color:var(--snow)">Let's talk.</h2>
    <p style="margin:0 0 1.5rem;max-width:var(--measure)">
      Call or text 972-815-7644, or email ling@xnjrealestate.com.
    </p>
    <a class="btn btn-primary" href="/contact">Get in touch</a>
  </section>
</Base>
