---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('neighborhoods'))
  .filter((g) => g.data.locale === 'en')
  .sort((a, b) => a.data.city.localeCompare(b.data.city));
---
<Base
  title="Ling Jordan | Real Estate in Plano, Frisco, McKinney, Prosper &amp; Allen"
  description="Licensed Texas agent with Golden Realty in Frisco. Residential sales, commercial real estate, and property management across Collin County. Service in English and Mandarin."
  path="/"
>
  <section class="wrap" style="padding-block:clamp(3rem,9vw,6.5rem)">
    <div style="display:flex;align-items:flex-start;gap:2rem;flex-wrap:wrap">
      <div style="flex:1 1 30rem">
        <p class="eyebrow">Collin County, Texas</p>
        <h1>Three ways I can help you with property.</h1>
        <p class="lede">
          I sell homes, broker commercial deals, and manage property for owners
          across Plano, Frisco, McKinney, Prosper, and Allen. Same licensed agent
          on all three &mdash; you will not get handed off.
        </p>
        <div class="btn-row" style="margin-top:2rem">
          <a class="btn btn-primary" href="/homes">Search homes</a>
          <a class="btn btn-secondary" href="/owners">I own property</a>
        </div>
      </div>
      <div style="flex:0 0 auto;margin-inline:auto">
        <Seal size={150} />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap tight stat-row">
      <div><p class="stat-n">50</p><p class="stat-l">Doors under management</p></div>
      <div><p class="stat-n">TACS</p><p class="stat-l">Accredited commercial specialist</p></div>
      <div><p class="stat-n">5</p><p class="stat-l">Collin County cities served</p></div>
      <div><p class="stat-n">2</p><p class="stat-l">Languages spoken in-house</p></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid grid-3 reveal">
      <article class="door">
        <h3>Residential</h3>
        <p>
          Buying and selling homes, including builder contracts on new
          construction &mdash; where the standard paperwork is written by the
          builder, for the builder.
        </p>
        <a href="/homes">Search homes &rarr;</a>
      </article>
      <article class="door door--brass">
        <h3>Commercial</h3>
        <p>
          Retail, office, flex, small industrial, multifamily, and land.
          I hold the Texas Accredited Commercial Specialist designation, which
          most residential agents do not.
        </p>
        <a href="/commercial">Commercial services &rarr;</a>
      </article>
      <article class="door door--deep">
        <h3>Property management</h3>
        <p>
          Fifty doors under management. Fees published on the site, because
          you should not have to fill out a form to learn what something costs.
        </p>
        <a href="/owners">Owner services &rarr;</a>
      </article>
    </div>
  </section>

  <section class="band">
    <div class="wrap section">
      <p class="eyebrow">Where I work</p>
      <h2 style="margin-top:0">Five cities, one county, in detail.</h2>
      <p class="prose">
        I do not claim to know all of Dallas&ndash;Fort Worth. I know Collin County,
        and these guides are written from actual transactions rather than
        rewritten chamber-of-commerce copy.
      </p>
      <div class="grid grid-3 reveal" style="margin-top:2rem">
        {guides.map((g) => (
          <a class="card" href={`/neighborhoods/${g.data.slug}`}>
            <h3>{g.data.city}</h3>
            <p style="margin:0;font-size:var(--step--1);color:var(--ink-soft)">{g.data.schoolDistrict}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid grid-2">
      <div>
        <p class="eyebrow">Working with me</p>
        <h2 style="margin-top:0">Service in English and Mandarin.</h2>
        <p class="prose">
          I work with clients in English and Mandarin, and I arrange interpreters
          for other languages at no cost to you. Contracts, disclosures, and
          closing documents are explained in the language you are most
          comfortable in &mdash; before you sign, not after.
        </p>
        <p><a href="/about">More about how I work &rarr;</a></p>
      </div>
      <div>
        <p class="eyebrow">Relocating to Texas</p>
        <h2 style="margin-top:0">New to the area?</h2>
        <p class="prose">
          Buyers moving here for work face questions local buyers never think
          about: lender requirements on a visa, whether to buy before permanent
          residency, how builder timelines interact with a start date, and which
          school zones actually match the district maps.
        </p>
        <p><a href="/contact">Ask me about your situation &rarr;</a></p>
      </div>
    </div>
  </section>

  <section class="band-jade">
    <div class="wrap section">
      <h2 style="margin-top:0">Let's talk about your property.</h2>
      <p style="max-width:var(--measure)">
        Call or text 972-815-7644. I answer my own phone, and there is no
        obligation attached to a first conversation.
      </p>
      <div class="btn-row" style="margin-top:1.75rem">
        <a class="btn btn-primary" href="/contact">Get in touch</a>
        <a class="btn btn-ghost" href="tel:+19728157644">Call 972-815-7644</a>
      </div>
    </div>
  </section>
</Base>
