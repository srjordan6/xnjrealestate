---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const services = await getCollection('services');
const entry = services.find((s) => s.data.slug === 'commercial' && s.data.locale === 'en')!;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} | Ling Jordan`} description={entry.data.description} path="/commercial">
  <header style="padding:1.25rem var(--gutter);border-bottom:1px solid var(--mist)">
    <a href="/" style="text-decoration:none;color:var(--jade)">&larr; Ling Jordan</a>
  </header>
  <article style="padding:clamp(2rem,6vw,4rem) var(--gutter);max-width:48rem">
    <h1 style="margin:0 0 2rem">{entry.data.title}</h1>
    <Content />
  </article>
</Base>
