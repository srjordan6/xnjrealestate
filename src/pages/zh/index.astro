---
import Base from '../../layouts/Base.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
---
<Base
  title="Ling Jordan | 科林县住宅、商业地产与物业管理"
  description="持照德州地产经纪，服务 Plano、Frisco、McKinney、Prosper、Allen。住宅买卖、商业地产、物业管理。提供中文服务。"
  path="/"
>
  <header style="display:flex;justify-content:space-between;align-items:center;padding:1.25rem var(--gutter);border-bottom:1px solid var(--mist)">
    <a href="/zh/" style="font-family:var(--font-display);font-size:var(--step-1);text-decoration:none;color:var(--jade)">Ling Jordan</a>
    <LanguageSwitcher path="/" />
  </header>

  <section style="padding:clamp(3rem,10vw,7rem) var(--gutter);max-width:60rem">
    <h1 style="margin:0 0 1.5rem">科林县的住宅、商业地产与物业管理</h1>
    <p style="max-width:var(--measure);font-size:var(--step-1);margin:0 0 2.5rem;color:var(--jade-deep)">
      持照德州地产经纪，办公室位于 Frisco。服务 Plano、Frisco、McKinney、Prosper、Allen。提供中英文服务。
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap">
      <a class="btn btn-primary" href="/homes">买房或卖房</a>
      <a class="btn btn-secondary" href="/owners">我是业主</a>
    </div>
  </section>

  <section style="padding:0 var(--gutter) clamp(3rem,8vw,5rem);max-width:60rem">
    <p style="font-size:var(--step--1)">
      TODO-COPY — 中文页面内容待补充。目前搜索与业主页面仍为英文。
    </p>
  </section>
</Base>
