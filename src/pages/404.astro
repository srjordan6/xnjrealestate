---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Ling Jordan" description="That page does not exist." path="/" noindex={true}>
  <section class="wrap section narrow" style="padding-block:clamp(4rem,12vw,7rem)">
    <h1>That page does not exist.</h1>
    <p class="lede">
      It may have moved, or the link may be mistyped. Try one of these, or call
      972-815-7644 and I will point you to it.
    </p>
    <div class="btn-row" style="margin-top:2rem">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/homes">Search homes</a>
      <a class="btn btn-secondary" href="/owners">Owner services</a>
    </div>
  </section>
</Base>
